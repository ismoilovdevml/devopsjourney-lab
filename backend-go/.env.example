# Backend environment for running on the host (`go run ./cmd/server` or
# `make run`). Copy to backend-go/.env; it is loaded automatically and is
# git-ignored. Start dependencies first: `make dev-deps` from the repo root,
# and use the DB/Redis passwords from the root .env.
#
# For the docker compose stack use the root .env.example instead.

# Server
PORT=8080
GIN_MODE=debug
ENVIRONMENT=development

# PostgreSQL (published on 127.0.0.1 by docker-compose.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=devopslab
DB_PASSWORD=
DB_NAME=devopslab
DB_SSLMODE=disable

# Redis (published on 127.0.0.1 by docker-compose.dev.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=24h
# Vite dev server runs on plain http://localhost:3000
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1/32

# Admin seeding
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Docker: DOCKER_HOST (e.g. tcp://127.0.0.1:2375) takes precedence when set;
# otherwise the local daemon socket below is used.
DOCKER_SOCKET=/var/run/docker.sock
DEFAULT_IMAGE=devopslab-lab:latest
TASKS_DIR=./tasks

# Lab container limits
SESSION_TTL=3600
MAX_SESSIONS_TOTAL=20
MEM_LIMIT=536870912
CPU_NANO=500000000
PIDS_LIMIT=256

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
