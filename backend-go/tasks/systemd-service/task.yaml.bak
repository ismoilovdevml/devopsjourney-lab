id: systemd-service
title: "Test 3: Systemd Service Creation"
image: ubuntu:22.04

setup:
  - apt-get update -qq
  - apt-get install -y systemd systemctl -qq

checks:
  - name: "Check if myapp.service file exists"
    cmd: test -f /etc/systemd/system/myapp.service
  - name: "Check if service contains correct ExecStart"
    cmd: grep -q "ExecStart=/usr/local/bin/myapp.sh" /etc/systemd/system/myapp.service
  - name: "Check if script file exists and is executable"
    cmd: test -x /usr/local/bin/myapp.sh
  - name: "Check if service is enabled"
    cmd: systemctl is-enabled myapp.service 2>/dev/null || systemctl list-unit-files | grep -q "myapp.service.*enabled"

order: 3
difficulty: 2
