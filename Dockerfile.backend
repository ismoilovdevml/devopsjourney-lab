FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache postgresql-client

# Create package.json
RUN echo '{"name":"devops-lab-backend","version":"2.0.0","dependencies":{"pg":"^8.11.0","dockerode":"^4.0.0"}}' > package.json

# Install Node.js dependencies
RUN npm install

# Copy backend file
COPY backend.js ./

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/healthz', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Start backend
CMD ["node", "backend.js"]
