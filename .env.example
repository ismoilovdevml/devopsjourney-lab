# ======================================
# DevOps Journey Lab - Environment Config
# ======================================

# ----------------
# Server Configuration
# ----------------
PORT=8080
GIN_MODE=release
ENVIRONMENT=production

# ----------------
# Database Configuration
# ----------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=devopslab
DB_PASSWORD=devopslab_secret
DB_NAME=devopslab
DB_SSLMODE=disable

# ----------------
# Redis Configuration
# ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------
# JWT Configuration
# ----------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# ----------------
# Docker Configuration
# ----------------
DOCKER_SOCKET=/var/run/docker.sock
DEFAULT_IMAGE=devopslab:latest
TASKS_DIR=./tasks

# Session Configuration
SESSION_TTL=3600
MEM_LIMIT=536870912
CPU_NANO=500000000
PIDS_LIMIT=256

# ----------------
# CORS Configuration
# ----------------
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ----------------
# Admin User Seeding
# IMPORTANT: Change these in production!
# ----------------
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@devopslab.com
ADMIN_PASSWORD=admin123

# ----------------
# Monitoring
# ----------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ----------------
# Frontend Configuration (for build time)
# ----------------
VITE_API_URL=http://localhost:8080/api
